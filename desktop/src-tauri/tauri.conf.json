{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhoneCam",
  "version": "2.0.0",
  "identifier": "com.phonecam.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PhoneCam",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0A0A0B",
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "rsxcore",
    "shortDescription": "Your phone as a webcam",
    "category": "Video",
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
